# Salin file ini menjadi .env (lokal) dan isi nilainya.
# Di Vercel, isi lewat Settings > Environment Variables. JANGAN commit file .env.

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=isi_dengan_anon_public_key
# RAHASIA. Hanya dipakai di server (api/). Jangan pernah ditaruh di folder public/.
SUPABASE_SERVICE_ROLE_KEY=isi_dengan_service_role_key

# Hanya untuk perintah: npm run create-admin (cukup di komputer lokal)
ADMIN_USERNAME=admin123
# Email "teknis" untuk Supabase Auth (tidak dipakai mengirim email). Kosongkan = otomatis.
ADMIN_EMAIL=
# Password awal admin untuk setup/pengujian. Wajib diganti saat login pertama.
ADMIN_INITIAL_PASSWORD=
